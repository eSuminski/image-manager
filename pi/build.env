# =================================================================
# GLOBAL BUILD CONFIGURATION
# =================================================================
# This file controls how the Image Manager behaves.
#
# INSTRUCTIONS:
# 1. This file is local to your machine. 
# 2. If you want to change the Registry or enable Multi-Arch builds,
#    edit the values below.
# 3. DO NOT commit sensitive credentials here if you plan to push 
#    this repo to a public repository.
# =================================================================

# The registry prefix where all images will be pushed.
# Example: ghcr.io/your-username
REGISTRY_PREFIX=ghcr.io/esuminski

# -----------------------------------------------------------------
# ENVIRONMENT MAPPINGS
# ----------------------------------------------------------------
# Add new environments here to enable auto-configuration.
# Format: ["directory_name"]="path/to/specialist_script"
# ----------------------------------------------------------------
declare -A PREP_SCRIPTS
PREP_SCRIPTS=(
    ["base-iso"]="./base-iso/model-manager.sh"
)

# -----------------------------------------------------------------
# BUILD SETTINGS
# ----------------------------------------------------------------
# Set to 'true' to automatically build for both amd64 and arm64.
# Note: This requires 'docker buildx' and will push to the registry.
FULL_BUILD_ENABLED=false