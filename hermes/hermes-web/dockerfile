FROM ubuntu:26.04

# =================================================================
# SYSTEM SETUP (as ROOT)
# =================================================================
ENV DEBIAN_FRONTEND=noninteractive
RUN apt update && apt upgrade -y && apt install -y \
    git \
    curl \
    wget \
    sudo \
    locales \
    libatomic1 \
    unzip \
    zip \
    xz-utils \
    build-essential \
    python3 \
    python3-pip \
    python3-venv \
    libffi-dev \
    ripgrep \
    ffmpeg \
    openssh-client \
    libasound2-plugins \
    && locale-gen en_US.UTF-8 \
    && update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
ENV SHELL=/bin/bash
ENV HOME=/root

# =================================================================
# INSTALL HERMES AGENT
# =================================================================
RUN curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash -s -- \
    --non-interactive \
    --skip-setup

RUN mkdir -p /tmp/hermes_template && cp -r /root/.hermes/. /tmp/hermes_template/
ENV PATH="/usr/local/bin:/root/.local/bin:${PATH}"

# =================================================================
# INSTALL HERMES WEB UI
# =================================================================
# 1. Clone the Web UI repository
WORKDIR /opt
RUN git clone https://github.com/nesquena/hermes-webui.git /opt/hermes-webui

# 2. Move to the Web UI directory to set it as a working context
WORKDIR /opt/hermes-webui

# Note: We don't run 'pip install' here because the bootstrap.py 
# script is designed to handle the virtualenv creation and 
# dependency installation automatically when the container starts.

# =================================================================
# WORKSPACE & PERMISSIONS SETUP
# =================================================================
RUN mkdir /workspace
WORKDIR /workspace

ENV USER_ID=0
ENV GROUP_ID=0

COPY ./entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]

# =================================================================
# STARTUP COMMAND
# =================================================================
# We change the CMD to call the bootstrap script.
# We point it to the Web UI directory and tell it to bind to 0.0.0.0
# so you can access it from your host machine.
# We use --foreground so the container doesn't exit immediately.
CMD ["python3", "/opt/hermes-webui/bootstrap.py", "--host", "0.0.0.0","--foreground", "1234"]